<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8">

    <!-- TOP HEADER -->

    <LinearLayout
        android:id="@+id/topSection"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/header_bg">

        <!-- CUSTOMER NAME -->

        <TextView
            android:id="@+id/customerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer Name"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="30sp"/>

        <!-- PHONE -->

        <TextView
            android:id="@+id/customerPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9876543210"
            android:textColor="#D7FFD9"
            android:textSize="15sp"
            android:layout_marginTop="6dp"/>

        <!-- BALANCE CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/balance_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending Balance"
                android:textColor="#777777"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/customerBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textColor="#1B5E20"
                android:textStyle="bold"
                android:textSize="38sp"
                android:layout_marginTop="10dp"/>

            <!-- CREDIT / DEBIT -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/creditTotalText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🟢 Credit: ₹0"
                    android:textColor="#2E7D32"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/debitTotalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔴 Debit: ₹0"
                    android:textColor="#C62828"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ACTION BUTTONS -->

    <LinearLayout
        android:id="@+id/actionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/topSection"
        android:padding="14dp">

        <Button
            android:id="@+id/addTransactionBtn"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="+ ADD"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#1B5E20"/>

        <Button
            android:id="@+id/shareBtn"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="SHARE"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#1565C0"
            android:layout_marginStart="10dp"/>

    </LinearLayout>

    <!-- TRANSACTION TITLE -->

    <TextView
        android:id="@+id/historyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transaction History"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="#212121"
        android:layout_below="@id/actionLayout"
        android:layout_marginStart="18dp"/>

    <!-- TRANSACTION LIST -->

    <ListView
        android:id="@+id/transactionList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/historyTitle"
        android:padding="12dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp"/>

</RelativeLayout>