<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- TOP GREEN SECTION -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/header_bg">

        <TextView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:gravity="center"
            android:text="📒"
            android:textSize="50sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Namma Santhe"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="34sp"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Shop Ledger"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <!-- LOGIN CARD -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:layout_below="@id/loginTopSpace"
        android:layout_marginTop="240dp"
        android:orientation="vertical"
        android:padding="22dp"
        android:background="@drawable/customer_card_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Login / Register"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#212121"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter mobile number and MPIN"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp"/>

        <!-- PHONE -->

        <EditText
            android:id="@+id/phoneInput"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:hint="Phone Number"
            android:inputType="phone"
            android:padding="14dp"
            android:textSize="16sp"
            android:background="@drawable/input_background"
            android:layout_marginTop="24dp"/>

        <!-- PIN -->

        <EditText
            android:id="@+id/pinInput"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:hint="4 Digit MPIN"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:padding="14dp"
            android:textSize="16sp"
            android:background="@drawable/input_background"
            android:layout_marginTop="16dp"/>

        <!-- BUTTON -->

        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="CONTINUE"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="#1B5E20"
            android:layout_marginTop="28dp"/>

    </LinearLayout>

    <!-- DUMMY SPACE -->

    <View
        android:id="@+id/loginTopSpace"
        android:layout_width="1dp"
        android:layout_height="1dp"/>

</RelativeLayout>