<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- TOOLBAR -->

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#1B5E20"
        app:title=""
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"/>

    <!-- TOP HEADER -->

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_below="@id/toolbar"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/header_bg">

        <!-- APP TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📒 Namma Santhe"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="32sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Shop Ledger"
            android:textColor="#D7FFD9"
            android:textSize="15sp"
            android:layout_marginTop="5dp"/>

        <!-- ANALYTICS CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:background="@drawable/balance_card"
            android:padding="18dp">

            <!-- TOTAL BALANCE -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TO COLLECT"
                    android:textColor="#777777"
                    android:textStyle="bold"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/totalBalanceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textColor="#1B5E20"
                    android:textStyle="bold"
                    android:textSize="36sp"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>

            <!-- CUSTOMER COUNT -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/customerCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#1B5E20"
                    android:textStyle="bold"
                    android:textSize="32sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customers"
                    android:textColor="#777777"
                    android:textSize="13sp"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- CUSTOMER TITLE -->

    <TextView
        android:id="@+id/customerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Customers"
        android:textColor="#212121"
        android:textStyle="bold"
        android:textSize="22sp"
        android:layout_below="@id/headerLayout"
        android:layout_marginStart="18dp"
        android:layout_marginTop="14dp"/>

    <!-- CUSTOMER LIST -->

    <ListView
        android:id="@+id/customerList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/customerTitle"
        android:padding="12dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp"
        android:layout_marginBottom="90dp"/>

    <!-- FLOATING BUTTON -->

    <ImageButton
        android:id="@+id/addCustomerBtn"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="20dp"
        android:background="@drawable/fab_bg"
        android:src="@android:drawable/ic_input_add"
        android:tint="#FFFFFF"/>

</RelativeLayout>